{
  "suitePath": "suites/xafs.json",
  "outputDir": "results",
  "trials": 1,
  "topK": 8,
  "answerer": {
    "type": "openai-compatible",
    "model": "glm-5.1",
    "baseUrl": "https://api.z.ai/api/coding/paas/v4/",
    "apiKeyEnv": "Z_AI_API_KEY",
    "temperature": 0,
    "maxTokens": 1024
  },
  "systems": [
    {
      "id": "lobu-plain",
      "label": "Lobu 11.3.0 (stock, raw query)",
      "type": "command",
      "argv": [
        "python3",
        "adapters/lobu_adapter.py"
      ],
      "env": {
        "LOBU_BASE_URL": "http://localhost:8799",
        "LOBU_ORG_SLUG": "local-install",
        "LOBU_API_TOKEN": "$LOBU_API_TOKEN",
        "LOBU_EMBED_WAIT": "120"
      },
      "topK": 8
    },
    {
      "id": "sm-plain",
      "label": "Supermemory v0.0.2 (self-hosted, plain)",
      "type": "command",
      "argv": [
        "python3",
        "adapters/supermemory_adapter.py"
      ],
      "env": {
        "SUPERMEMORY_BASE_URL": "http://localhost:6767",
        "SUPERMEMORY_API_KEY": "$SUPERMEMORY_API_KEY"
      },
      "topK": 8
    }
  ]
}